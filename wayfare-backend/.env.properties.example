# ============================================================
# Wayfare 本地开发密钥文件 · 模板
# ------------------------------------------------------------
# 用法：把本文件复制成同目录下的 .env.properties，然后填入自己的 Key。
#     copy .env.properties.example .env.properties
# 本模板会入库，.env.properties 已被 .gitignore 排除，二者内容一致。
#
# 【怎么用】填好 Key 后保存，重启后端：
#     cd wayfare-backend
#     mvn spring-boot:run
#
# 【原理】application.yml 里写的是 ${GLM_API_KEY:} 这种占位符；
#   本文件被导入后，里面的 GLM_API_KEY 就成了一个配置项，占位符即可解析到它。
#   所以「系统环境变量」与「本文件」两种方式都能生效，任选其一。
# ============================================================

# ---------- 本机 MySQL ----------
# 数据源密码。application.yml 的 ${MYSQL_ROOT_PASSWORD:} 会解析到这里
MYSQL_ROOT_PASSWORD=

# ---------- 智谱 GLM ----------
# 申请地址：https://open.bigmodel.cn  模型默认 glm-4-flash（开发调试几乎不花钱）
GLM_API_KEY=

# ---------- DeepSeek ----------
# 申请地址：https://platform.deepseek.com  模型默认 deepseek-chat
# 可选：留空则该厂商视为未配置，降级顺序会自动跳过它
DEEPSEEK_API_KEY=

# ---------- 百度地图 Web 服务 AK ----------
# 可选：留空则地图能力整体关闭，全流程走估算模式（ESTIMATED），系统照样全功能可用
BAIDU_MAP_AK=
