# ============================================================
# Wayfare 本地开发密钥文件 · 模板
# ------------------------------------------------------------
# 用法：把本文件复制成同目录下的 .env.properties，然后填入自己的 Key。
#     copy .env.properties.example .env.properties
# 本模板会入库，.env.properties 已被 .gitignore 排除，二者内容一致。
#
# 【怎么用】填好 Key 后保存，重启后端：
#     cd wayfare-backend
#     mvn spring-boot:run
#
# 【原理】application.yml 里写的是 ${GLM_API_KEY:} 这种占位符；
#   本文件被导入后，里面的 GLM_API_KEY 就成了一个配置项，占位符即可解析到它。
#   所以「系统环境变量」与「本文件」两种方式都能生效，任选其一。
# ============================================================

# ---------- 本机 MySQL ----------
# 数据源密码。application.yml 的 ${MYSQL_ROOT_PASSWORD:} 会解析到这里
MYSQL_ROOT_PASSWORD=

# ---------- 阿里云百炼 Qwen ----------
# 申请地址：https://bailian.console.aliyun.com  模型默认 qwen3.8-flash
# 说明：三个大模型厂商的 Key **都可不填** —— 全空时自动回落内置离线 Mock，链路照常演示。
# ⚠️ 百炼的模型名大小写敏感，必须全小写；写成 qwen3.8-Flash 会报 model_not_found
# ⚠️ 实测 qwen3.8-flash 已不适合承担长结构化输出（476s/次、失败率 55%），详见开发文档 §19
QWEN_API_KEY=

# ---------- 智谱 GLM ----------
# 申请地址：https://open.bigmodel.cn  模型默认 glm-5.3-flash（模型名在 application.yml 的 llm.providers.glm.model 改）
# ⚠️ glm-5.3 系列**强制思考、不允许关闭**，必须显式下发 reasoning-effort（application.yml 已配 low）；
#    不传强度时它按默认高档跑，表现为「超时且无任何返回」，看起来像挂了
GLM_API_KEY=

# ---------- DeepSeek ----------
# 申请地址：https://platform.deepseek.com  模型默认 deepseek-flash（= DeepSeek-V4.1-Flash）
# ⚠️ deepseek-chat 已不在官方模型列表；deepseek-flash 是推理模型，必须显式下发 reasoning_effort
#    参数名必须写 reasoning_effort（写成 effort 会被静默忽略）
DEEPSEEK_API_KEY=

# ---------- 百度地图 Web 服务 AK ----------
# 申请地址：https://lbsyun.baidu.com  应用类型选「服务端」
# 可选：留空则地图能力整体关闭，全流程走估算模式（ESTIMATED），系统照样全功能可用
# ⚠️ 地点检索免费额度 100 次/天、并发 3 QPS（status=401 是并发超限，不是日额度用完）
BAIDU_MAP_AK=
